<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="de-DE">
  <info>
    <title>Ameisen Wiens – Literaturverzeichnis</title>
    <title-short>Ameisen Wiens</title-short>
    <id>http://www.zobodat.at/csl/ameisen-wiens</id>
    <link href="http://www.zobodat.at/csl/ameisen-wiens" rel="self"/>
    <updated>2026-10-24T00:00:00+00:00</updated>
    <author>
      <name>Custom style based on the Ameisen Wiens bibliography template</name>
    </author>
    <summary>Custom author-year bibliography style based on the supplied Ameisen Wiens literature template.</summary>
    <category citation-format="author-date"/>
    <category field="biology"/>
    <rights license="http://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</rights>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=" "
            initialize-with=". "
            initialize="true"
            delimiter=", "
            and="text"
            delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all"
                sort-separator=" "
                initialize-with=". "
                initialize="true"
                delimiter=", "
                and="text"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-year">
    <text macro="author"/>
    <date variable="issued" prefix=" ">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <text variable="title"/>
  </macro>

  <macro name="container">
    <group delimiter=" ">
      <text variable="container-title"/>
      <text variable="volume"/>
      <text variable="issue" prefix=" (" suffix=")"/>
    </group>
  </macro>

  <macro name="pages">
    <text variable="page" prefix=": "/>
  </macro>

  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <macro name="access">
    <group delimiter=" ">
      <text variable="URL"/>
      <date variable="accessed" prefix="(" suffix=")">
        <text term="accessed" text-case="lowercase" suffix=" "/>
        <date-part name="day" suffix=". "/>
        <date-part name="month" form="long" suffix=" "/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>

  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <text macro="author-year"/>
    </layout>
  </citation>

  <bibliography hanging-indent="false" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>

    <layout suffix=".">
      <text macro="author-year" suffix=": "/>

      <choose>
        <!-- Journal articles -->
        <if type="article-journal" match="any">
          <text macro="title"/>
          <text macro="container" prefix=" – "/>
          <text macro="pages"/>
        </if>

        <!-- Book chapters / contributions -->
        <else-if type="chapter paper-conference entry-encyclopedia" match="any">
          <text macro="title"/>
          <text value=" – In: " />
          <names variable="editor">
            <name name-as-sort-order="all"
                  sort-separator=" "
                  initialize-with=". "
                  initialize="true"
                  delimiter=", "
                  and="text"/>
            <label form="short" prefix=" " />
          </names>
          <text variable="container-title" prefix=": "/>
          <group prefix=", ">
            <text variable="edition" suffix="."/>
          </group>
          <text macro="publisher" prefix=" – "/>
          <text macro="pages"/>
        </else-if>

        <!-- Books -->
        <else-if type="book" match="any">
          <text macro="title"/>
          <text macro="publisher" prefix=" – "/>
          <text variable="number-of-pages" prefix=", " suffix=" pp."/>
        </else-if>

        <!-- Web pages / online sources -->
        <else-if type="webpage post-weblog post" match="any">
          <text macro="title"/>
          <text variable="URL" prefix=": "/>
          <date variable="accessed" prefix=" (aufgerufen am " suffix=")">
            <date-part name="day" suffix=". "/>
            <date-part name="month" form="long" suffix=" "/>
            <date-part name="year"/>
          </date>
        </else-if>

        <!-- Generic fallback -->
        <else>
          <text macro="title"/>
          <text macro="publisher" prefix=" – "/>
          <text macro="pages"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
