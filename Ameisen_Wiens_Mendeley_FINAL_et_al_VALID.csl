<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="de-DE">
  <info>
    <title>Ameisen Wiens</title>
    <title-short>Ameisen Wiens</title-short>
    <id>https://www.zotero.org/styles/ameisen-wiens</id>
    <link href="https://www.zotero.org/styles/ameisen-wiens" rel="self"/>
    <updated>2026-10-24T00:00:00+00:00</updated>
    <author><name>Custom style based on the Ameisen Wiens bibliography template</name></author>
    <summary>Author-year bibliography style based on the supplied Ameisen Wiens literature template.</summary>
    <category citation-format="author-date"/>
    <category field="biology"/>
  </info>
  <locale xml:lang="de-DE">
    <terms>
      <term name="et-al">et al.</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", " and="symbol" et-al-min="2" et-al-use-first="1"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", " and="symbol" et-al-min="2" et-al-use-first="1"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-year">
    <text macro="author"/>
    <date variable="issued" prefix=" "><date-part name="year"/></date>
  </macro>
  <macro name="citation-author-year">
    <text macro="author"/>
    <date variable="issued" prefix=" ">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", " and="symbol" et-al-min="2" et-al-use-first="1"/>
    </names>
  </macro>
  <citation>
    <layout prefix="(" suffix=")" delimiter=", "><text macro="citation-author-year"/></layout>
  </citation>
  <bibliography hanging-indent="false" entry-spacing="0" line-spacing="1">
    <sort><key macro="author"/><key variable="issued"/></sort>
    <layout suffix=".">
      <text macro="author-year" suffix=": "/>
      <choose>
        <if type="article-journal">
          <text variable="title"/>
          <text variable="container-title" prefix=" – "/>
          <group prefix=" "><text variable="volume"/><text variable="issue" prefix=" (" suffix=")"/></group>
          <text variable="page" prefix=": "/>
        </if>
        <else-if type="chapter paper-conference entry-encyclopedia">
          <text variable="title"/>
          <text value=" – In: "/>
          <text macro="editor"/>
          <text value=" (Hrsg.): "/>
          <text variable="container-title"/>
          <text variable="edition" prefix=", Bd. "/>
          <text variable="publisher" prefix=" – "/>
          <text variable="publisher-place" prefix=", "/>
          <text variable="page" prefix=", pp. "/>
        </else-if>
        <else-if type="book">
          <text variable="title"/>
          <text variable="publisher" prefix=" – "/>
          <text variable="publisher-place" prefix=", "/>
          <text variable="number-of-pages" prefix=", " suffix=" pp."/>
        </else-if>
        <else-if type="webpage">
          <text variable="title"/>
          <text variable="URL" prefix=": "/>
          <date variable="accessed" prefix=" (aufgerufen am " suffix=")">
            <date-part name="day" suffix=". "/>
            <date-part name="month" form="long" suffix=" "/>
            <date-part name="year"/>
          </date>
        </else-if>
        <else>
          <text variable="title"/>
          <text variable="publisher" prefix=" – "/>
          <text variable="publisher-place" prefix=", "/>
          <text variable="page" prefix=": "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
